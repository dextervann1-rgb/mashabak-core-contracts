# VFV LLC — Deployment Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or a real private key.

# Deployer private key — use a dedicated wallet for testnet.
# For mainnet, prefer a Safe multisig or hardware wallet.
DEPLOYER_PRIVATE_KEY=

BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org
BSC_TESTNET_RPC=
BSC_MAINNET_RPC=

BASESCAN_API_KEY=
BSCSCAN_API_KEY=

# Existing transparent proxy used by upgrade scripts.
BSC_TESTNET_PROXY_ADDRESS=
